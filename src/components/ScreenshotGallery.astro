---
interface Screenshot {
	file: string;
	alt: string;
	caption: string;
}

interface Props {
	project: string;
	screenshots: Screenshot[];
}

const { project, screenshots } = Astro.props;
---

<section class="screenshot-section" aria-labelledby={`${project}-screenshots`}>
	<div class="section-heading">
		<div>
			<span class="section-label">Product in practice</span>
			<h2 id={`${project}-screenshots`}>A closer look</h2>
		</div>
		<span class="screen-count">{screenshots.length} screens</span>
	</div>
	<div class="screenshot-grid">
		{screenshots.map((screenshot, index) => (
			<figure class="screenshot-card">
				<a href={`/projects/${project}/${screenshot.file}`} target="_blank" rel="noreferrer">
					<img src={`/projects/${project}/${screenshot.file}`} alt={screenshot.alt} loading={index === 0 ? 'eager' : 'lazy'} />
				</a>
				<figcaption>
					<span>0{index + 1}</span>
					{ screenshot.caption }
				</figcaption>
			</figure>
		))}
	</div>
</section>

<style>
	.screenshot-section {
		margin-top: 4rem;
		padding: 2rem 0 1rem;
		border-top: 1px solid #1e293b;
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.section-label {
		color: #38bdf8;
		font: 700 0.72rem system-ui, sans-serif;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h2 {
		color: #ffffff;
		font-size: 2rem;
		margin: 0.5rem 0 0;
	}
	.screen-count {
		color: #64748b;
		font: 0.78rem system-ui, sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.screenshot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: 1rem;
	}
	.screenshot-card {
		margin: 0;
		background: #111827;
		border: 1px solid #1f2937;
		border-radius: 0.75rem;
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}
	.screenshot-card:hover {
		border-color: #38bdf8;
		transform: translateY(-3px);
	}
	.screenshot-card a {
		display: block;
		background: #020617;
	}
	.screenshot-card img {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		object-position: top;
	}
	figcaption {
		display: flex;
		gap: 0.55rem;
		padding: 0.75rem;
		color: #cbd5e1;
		font: 0.78rem/1.4 system-ui, sans-serif;
	}
	figcaption span {
		color: #38bdf8;
		font-weight: 700;
	}
	@media (max-width: 560px) {
		.screenshot-section { margin-top: 3rem; }
		.section-heading { align-items: start; flex-direction: column; }
		h2 { font-size: 1.8rem; }
		.screenshot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
		figcaption { padding: 0.6rem; font-size: 0.7rem; }
	}
</style>
