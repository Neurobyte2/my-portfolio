---
interface Screenshot {
	file: string;
	alt: string;
	caption: string;
}

interface Props {
	project: string;
	screenshots: Screenshot[];
}

const { project, screenshots } = Astro.props;
const headingId = `${project}-screenshots`;

const imageURL = (file: string) =>
	`/projects/${encodeURIComponent(project)}/${file
		.split('/')
		.map((segment) => encodeURIComponent(segment))
		.join('/')}`;
---

{screenshots.length > 0 && (
	<section class="screenshot-section" aria-labelledby={headingId}>
		<div class="section-heading">
			<div>
				<span class="section-label">App screenshots</span>
				<h2 id={headingId}>Explore the app experience.</h2>
				<p>Open any screenshot to view it at full size.</p>
			</div>
			<span class="screen-count">
				{screenshots.length} {screenshots.length === 1 ? 'screen' : 'screens'}
			</span>
		</div>

		<div class="screenshot-grid">
			{screenshots.map((screenshot, index) => (
				<figure class="screenshot-card">
					<a
						class="screenshot-link"
						href={imageURL(screenshot.file)}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Open ${screenshot.caption || screenshot.alt} at full size in a new tab`}
					>
						<img
							src={imageURL(screenshot.file)}
							alt={screenshot.alt}
							loading="lazy"
							decoding="async"
						/>
						<span class="expand-label" aria-hidden="true">View full size ↗</span>
					</a>
					<figcaption>
						<span class="screen-number" aria-hidden="true">
							{String(index + 1).padStart(2, '0')}
						</span>
						<span>{screenshot.caption}</span>
					</figcaption>
				</figure>
			))}
		</div>
	</section>
)}

<style>
	.screenshot-section {
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.section-label {
		color: #75d6ff;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0.5rem 0 0;
		font-size: clamp(1.8rem, 3.2vw, 2.5rem);
		line-height: 1.2;
		letter-spacing: -0.035em;
	}
	.section-heading p {
		margin: 0.8rem 0 0;
		color: var(--color-muted);
		font-size: 0.85rem;
	}
	.screen-count {
		flex-shrink: 0;
		padding: 0.35rem 0.7rem;
		border: 1px solid #2a4057;
		border-radius: 999px;
		color: #c5d2e3;
		font-size: 0.73rem;
	}
	.screenshot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		align-items: start;
		gap: 1.25rem;
	}
	.screenshot-card {
		width: 100%;
		max-width: 340px;
		margin: 0;
		justify-self: center;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}
	.screenshot-card:hover { border-color: #3a8cad; }
	.screenshot-link {
		position: relative;
		display: block;
		aspect-ratio: 9 / 19.5;
		padding: 0.75rem;
		background: #0a111d;
	}
	.screenshot-link img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.expand-label {
		position: absolute;
		right: 0.7rem;
		bottom: 0.7rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid #2a4057;
		border-radius: 999px;
		background: #080d17ed;
		color: #b8edff;
		font-size: 0.65rem;
		pointer-events: none;
	}
	figcaption {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 1rem;
		border-top: 1px solid var(--color-border);
		color: #c5d2e3;
		font-size: 0.8rem;
		line-height: 1.5;
	}
	.screen-number {
		flex-shrink: 0;
		color: #75d6ff;
		font-size: 0.72rem;
		font-weight: 750;
	}
	@media (max-width: 560px) {
		.screenshot-section { margin-top: 3rem; padding-top: 2rem; }
		.section-heading { align-items: flex-start; flex-direction: column; gap: 0.8rem; }
		.screenshot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
		.screenshot-link { padding: 0.4rem; }
		.expand-label { right: 0.4rem; bottom: 0.4rem; font-size: 0.58rem; }
		figcaption { padding: 0.75rem; font-size: 0.72rem; gap: 0.45rem; }
	}
	@media (max-width: 360px) {
		.screenshot-grid { grid-template-columns: 1fr; }
	}
</style>