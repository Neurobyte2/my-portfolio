---
import Layout from '../layouts/Layout.astro';

interface Props {
	title: string;
	description: string;
	category: string;
	status: string;
	image: string;
	imageAlt: string;
	overview: string;
	role: string;
	technologies: string[];
	highlights: string[];
	liveUrl?: string;
	liveLabel?: string;
	launchNote?: string;
}

const {
	title,
	description,
	category,
	status,
	image,
	imageAlt,
	overview,
	role,
	technologies,
	highlights,
	liveUrl,
	liveLabel = 'Visit live website',
	launchNote,
} = Astro.props;

const statusTone =
	status === 'In progress'
		? 'progress'
		: status === 'Live'
			? 'live'
			: 'neutral';
---

<Layout
	title={`${title} | Ali Ansar Project Case Study`}
	description={description}
	image={image}
	imageAlt={imageAlt}
>
	<main class="case-shell">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/projects/">Projects</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{title}</span>
		</nav>

		<header class="case-header">
			<div class="case-meta">
				<span class="category">{category}</span>
				<span class:list={['status', statusTone]}>{status}</span>
			</div>
			<h1>{title}</h1>
			<p>{description}</p>
			<div class="actions">
				{liveUrl && (
					<a
						class="button primary"
						href={liveUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						{liveLabel} <span aria-hidden="true">↗</span>
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				)}
				<a class="button secondary" href="#project-overview">
					Explore project details <span aria-hidden="true">↓</span>
				</a>
			</div>
			{launchNote && <p class="launch-note">{launchNote}</p>}
		</header>

		<figure class="case-image">
			<a
				href={image}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Open the full ${title} preview in a new tab`}
			>
				<img
					src={image}
					alt={imageAlt}
					loading="eager"
					decoding="async"
				/>
			</a>
			<figcaption>
				<span>{title} — website preview</span>
				<span>Open image for a closer look ↗</span>
			</figcaption>
		</figure>

		<div class="case-content">
			<div class="case-story">
				<section id="project-overview" aria-labelledby="overview-title">
					<span class="section-label">Project overview</span>
					<h2 id="overview-title">The purpose behind the project.</h2>
					<p>{overview}</p>
				</section>

				{highlights.length > 0 && (
					<section class="highlights" aria-labelledby="highlights-title">
						<span class="section-label">Project highlights</span>
						<h2 id="highlights-title">Features & implementation.</h2>
						<ul class="highlight-list">
							{highlights.map((highlight) => <li>{highlight}</li>)}
						</ul>
					</section>
				)}
			</div>

			<aside class="details-card" aria-labelledby="details-title">
				<h2 id="details-title">Project details</h2>
				<dl>
					<div>
						<dt>My role</dt>
						<dd>{role}</dd>
					</div>
					<div>
						<dt>Project category</dt>
						<dd>{category}</dd>
					</div>
					<div>
						<dt>Status</dt>
						<dd>{status}</dd>
					</div>
				</dl>
				{technologies.length > 0 && (
					<div class="technology-section">
						<h3>Tools & focus</h3>
						<ul class="tag-list">
							{technologies.map((technology) => <li>{technology}</li>)}
						</ul>
					</div>
				)}
				<a class="text-link" href="/services/web-development/">
					Explore web development <span aria-hidden="true">→</span>
				</a>
			</aside>
		</div>

		<nav class="project-navigation" aria-label="Project navigation">
			<a class="text-link" href="/projects/">
				<span aria-hidden="true">←</span> Browse all projects
			</a>
			<a class="text-link" href="/contact/">
				Discuss a similar project <span aria-hidden="true">↗</span>
			</a>
		</nav>
	</main>
</Layout>

<style>
	.case-shell {
		width: min(1120px, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 2rem 4rem;
	}
	h1, h2, h3, p { margin-top: 0; }
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: var(--color-muted);
		font-size: 0.75rem;
	}
	.breadcrumb a { color: #75d6ff; text-decoration: none; }
	.breadcrumb a:hover { text-decoration: underline; }
	.case-header { max-width: 900px; padding-block: 2.5rem; }
	.case-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
	.category, .status {
		padding: 0.3rem 0.65rem;
		border: 1px solid #2a4057;
		border-radius: 999px;
		color: #b7dff3;
		font-size: 0.7rem;
		font-weight: 650;
	}
	.live { border-color: #34d39955; background: #0a211b; color: #76e3ba; }
	.progress { border-color: #fbbf2455; background: #261a0c; color: #ffd092; }
	.neutral { border-color: #38bdf855; background: #0c2032; color: #9adeff; }
	.case-header h1 {
		margin: 1rem 0;
		font-size: clamp(2.6rem, 5.5vw, 4.6rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
		overflow-wrap: anywhere;
	}
	.case-header > p { max-width: 760px; color: var(--color-muted); font-size: 1rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 48px;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		font-size: 0.83rem;
		font-weight: 750;
		text-decoration: none;
	}
	.primary { background: var(--color-accent); color: #04111d; }
	.primary:hover { background: #75d6ff; }
	.secondary { border-color: #2c4058; background: #111a29; color: var(--color-text); }
	.secondary:hover { border-color: var(--color-accent); }
	.case-header .launch-note { margin: 1rem 0 0; color: #ffd092; font-size: 0.8rem; }
	.case-image {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}
	.case-image a {
		display: block;
		aspect-ratio: 1.7;
		overflow: hidden;
		background: #111a29;
	}
	.case-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.case-image figcaption {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.85rem 1rem;
		color: var(--color-muted);
		font-size: 0.72rem;
	}
	.case-content {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		align-items: start;
		gap: 3rem;
		margin-top: 3rem;
	}
	.section-label {
		color: #75d6ff;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.case-story h2 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		line-height: 1.2;
		letter-spacing: -0.035em;
	}
	.case-story p, .highlight-list li { color: var(--color-muted); font-size: 0.9rem; }
	.highlights { margin-top: 2.5rem; }
	.highlight-list { display: grid; gap: 0.85rem; margin: 0; padding-left: 1.2rem; }
	.highlight-list li::marker { color: var(--color-accent); }
	.details-card {
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: var(--color-surface);
	}
	.details-card h2 { margin-bottom: 1rem; font-size: 1.1rem; }
	.details-card dl { margin: 0; }
	.details-card dl > div { padding-block: 0.85rem; border-bottom: 1px solid var(--color-border); }
	.details-card dt { margin-bottom: 0.3rem; color: var(--color-muted); font-size: 0.72rem; }
	.details-card dd { margin: 0; font-size: 0.85rem; overflow-wrap: anywhere; }
	.technology-section { margin-block: 1.25rem; }
	.technology-section h3 { margin-bottom: 0.75rem; font-size: 0.8rem; }
	.tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
	.tag-list li { padding: 0.35rem 0.6rem; border: 1px solid #2a4057; border-radius: 999px; color: #c5d2e3; font-size: 0.7rem; }
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 40px;
		color: #75d6ff;
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}
	.text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
	.project-navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 760px) {
		.case-content { grid-template-columns: 1fr; gap: 2rem; }
	}
	@media (max-width: 560px) {
		.case-shell { width: calc(100% - 2.5rem); }
		.actions { flex-direction: column; }
		.case-header > p { font-size: 0.94rem; }
		.case-image a { aspect-ratio: 1.3; }
		.case-content { margin-top: 2.5rem; }
		.project-navigation { align-items: flex-start; flex-direction: column; }
	}
</style>