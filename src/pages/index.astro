---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="portfolio-container">
		<!-- Hero Section -->
		<section class="hero">
			<div class="badge">Available for International Opportunities</div>
			<h1>Hi, I'm Ali Ansar</h1>
			<h2>Native Android & Full-Stack Engineer</h2>
			<p>Building high-performance, production-grade mobile applications with clean architecture, real-time dashboards, and modern UI.</p>
			
			<div class="cta-buttons">
				<a href="https://github.com/Neurobyte2" target="_blank" class="btn primary">GitHub Profile</a>
				<a href="https://www.linkedin.com/in/ali-ansar-536153366" target="_blank" class="btn secondary">LinkedIn</a>
				<a href="https://wa.me/923479951664" target="_blank" class="btn whatsapp">WhatsApp Chat</a>
			</div>
		</section>

		<!-- Projects Section -->
		<section class="projects">
			<h2>Featured Projects</h2>
			
			<a href="/projects/campusnotify" class="project-card highlight project-card-link">
				<span class="tag">Flagship Platform</span>
				<h3>CampusNotify</h3>
				<p>A fully functional, comprehensive campus communication ecosystem featuring dedicated Student and Admin Dashboards.</p>
				<div class="tech-stack">
					<span>Native Android</span>
					<span>Clean Architecture</span>
					<span>Firebase</span>
				</div>
				<div class="card-cta">View Full Case Study &rarr;</div>
			</a>

			<div class="project-card">
				<h3>Semesta</h3>
				<p>An advanced native Android application showcasing modern UI patterns, modular architecture, and robust state management for a smooth user experience.</p>
				<div class="tech-stack">
					<span>Jetpack Compose</span>
					<span>Clean Architecture</span>
					<span>Kotlin</span>
				</div>
				<div style="margin-top: 1.5rem;">
					<a href="/projects/semesta" class="btn primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">View Full Case Study &rarr;</a>
				</div>
			</div>

			<a href="/projects/flashcard-quiz" class="project-card project-card-link">
				<h3>Flash Quiz Card</h3>
				<p>An interactive utility application built for active learning and efficient retention, featuring dynamic card flipping logic and performance tracking.</p>
				<div class="tech-stack">
					<span>Jetpack Compose</span>
					<span>Room Database</span>
					<span>Clean Architecture</span>
				</div>
				<div class="card-cta">View Full Case Study &rarr;</div>
			</a>

			<a href="/projects/asterloom" class="project-card project-card-link">
				<h3>Asterloom</h3>
				<p>A modern Android application focused on intuitive navigation, polished UI, reusable components, and scalable development practices.</p>
				<div class="tech-stack">
					<span>Jetpack Compose</span>
					<span>MVVM</span>
					<span>Clean Architecture</span>
				</div>
				<div class="card-cta">View Full Case Study &rarr;</div>
			</a>
		</section>

		<!-- Contact Section -->
		<section class="contact-section">
			<h2>Get In Touch</h2>
			<p>Let's build something exceptional together. Reach out via direct call, WhatsApp, or professional networks.</p>
			
			<div class="contact-grid">
				<div class="contact-item">
					<strong>Phone / WhatsApp:</strong>
					<a href="tel:+923479951664">+92 347 9951664</a>
				</div>
				<div class="contact-item">
					<strong>Email:</strong>
					<a href="mailto:aliedits1129@gmail.com">aliedits1129@gmail.com</a>
				</div>
				<div class="contact-item">
					<strong>GitHub:</strong>
					<a href="https://github.com/Neurobyte2" target="_blank">github.com/Neurobyte2</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	body {
		font-family: system-ui, -apple-system, sans-serif;
		background-color: #090d16;
		color: #f1f5f9;
		margin: 0;
		padding: 0;
		line-height: 1.6;
	}
	.portfolio-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 5rem 2rem;
	}
	.hero {
		text-align: center;
		margin-bottom: 5rem;
	}
	.badge {
		display: inline-block;
		background: rgba(56, 189, 248, 0.1);
		color: #38bdf8;
		padding: 0.35rem 1rem;
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(56, 189, 248, 0.2);
	}
	.hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
		color: #ffffff;
		letter-spacing: -0.02em;
	}
	.hero h2 {
		font-size: 1.5rem;
		color: #38bdf8;
		margin-bottom: 1rem;
		font-weight: 500;
	}
	.hero p {
		font-size: 1.15rem;
		color: #94a3b8;
		max-width: 650px;
		margin: 0 auto 2.5rem auto;
	}
	.cta-buttons {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.2s ease;
	}
	.btn.primary {
		background-color: #38bdf8;
		color: #090d16;
	}
	.btn.primary:hover {
		background-color: #0ea5e9;
	}
	.btn.secondary {
		background-color: #1e293b;
		color: #f1f5f9;
		border: 1px solid #334155;
	}
	.btn.whatsapp {
		background-color: #22c55e;
		color: #ffffff;
	}
	.projects h2, .contact-section h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		color: #ffffff;
		border-bottom: 1px solid #1e293b;
		padding-bottom: 0.75rem;
	}
	.project-card {
		background-color: #111827;
		padding: 2rem;
		border-radius: 1rem;
		margin-bottom: 1.5rem;
		border: 1px solid #1f2937;
		position: relative;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}
	.project-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.card-cta {
		margin-top: 1.5rem;
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		background-color: #38bdf8;
		color: #090d16;
		font-weight: 600;
		font-size: 0.9rem;
	}
	.project-card:hover {
		border-color: #38bdf8;
		transform: translateY(-2px);
	}
	.project-card.highlight {
		border-color: rgba(56, 189, 248, 0.4);
		background: linear-gradient(135deg, #111827 0%, #162032 100%);
	}
	.tag {
		background: #0284c7;
		color: #ffffff;
		font-size: 0.7rem;
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
		text-transform: uppercase;
		font-weight: bold;
		letter-spacing: 0.05em;
	}
	.project-card h3 {
		font-size: 1.5rem;
		margin: 0.75rem 0 0.5rem 0;
		color: #38bdf8;
	}
	.project-card p {
		color: #94a3b8;
		margin-bottom: 1.5rem;
	}
	.tech-stack {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.tech-stack span {
		background: #1f2937;
		color: #cbd5e1;
		font-size: 0.8rem;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
	}
	.contact-section {
		margin-top: 5rem;
		background: #111827;
		padding: 3rem;
		border-radius: 1rem;
		border: 1px solid #1f2937;
		text-align: center;
	}
	.contact-section p {
		color: #94a3b8;
		margin-bottom: 2rem;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		text-align: left;
	}
	.contact-item {
		background: #1f2937;
		padding: 1rem 1.25rem;
		border-radius: 0.5rem;
	}
	.contact-item strong {
		display: block;
		font-size: 0.85rem;
		color: #94a3b8;
		margin-bottom: 0.25rem;
	}
	.contact-item a {
		color: #38bdf8;
		text-decoration: none;
		font-weight: 600;
	}
	.contact-item a:hover {
		text-decoration: underline;
	}
</style>