---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="portfolio-container">
		<section class="hero">
			<h1>Hi, I'm a Native Android Engineer</h1>
			<p>Building high-performance, clean-architecture mobile applications for global impact.</p>
			<div class="cta-buttons">
				<a href="https://github.com/your-github-username" target="_blank" class="btn primary">GitHub Profile</a>
				<a href="mailto:your-email@example.com" class="btn secondary">Get in Touch</a>
			</div>
		</section>

		<section class="projects">
			<h2>Featured Projects</h2>
			
			<div class="project-card">
				<h3>Asterloom</h3>
				<p>A focused Pomodoro and productivity tool built with native Android, Jetpack Compose, and robust architectural principles.</p>
			</div>

			<div class="project-card">
				<h3>Semesta</h3>
				<p>An advanced native Android application showcasing modern UI design patterns, clean codebases, and seamless state management.</p>
			</div>

			<div class="project-card">
				<h3>CampusNotify</h3>
				<p>A real-time notification and utility application designed to streamline student communication and campus updates.</p>
			</div>
		</section>
	</main>
</Layout>

<style>
	body {
		font-family: system-ui, -apple-system, sans-serif;
		background-color: #0f172a;
		color: #f8fafc;
		margin: 0;
		padding: 0;
	}
	.portfolio-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	.hero {
		text-align: center;
		margin-bottom: 4rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: #38bdf8;
	}
	.hero p {
		font-size: 1.2rem;
		color: #94a3b8;
		margin-bottom: 2rem;
	}
	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: bold;
		margin: 0 0.5rem;
	}
	.btn.primary {
		background-color: #38bdf8;
		color: #0f172a;
	}
	.btn.secondary {
		border: 1px solid #38bdf8;
		color: #38bdf8;
	}
	.projects h2 {
		font-size: 1.8rem;
		border-bottom: 2px solid #1e293b;
		padding-bottom: 0.5rem;
		margin-bottom: 2rem;
	}
	.project-card {
		background-color: #1e293b;
		padding: 1.5rem;
		border-radius: 0.75rem;
		margin-bottom: 1.5rem;
		border: 1px solid #334155;
	}
	.project-card h3 {
		margin-top: 0;
		color: #38bdf8;
	}
</style>