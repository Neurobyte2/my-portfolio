---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		number: '01',
		title: 'Web development',
		text: 'Business websites and custom web applications that present your services and support your workflows.',
		tools: 'Astro · React · Next.js',
		href: '/services/web-development/',
	},
	{
		number: '02',
		title: 'Android app development',
		text: 'Native Android apps with clear screens, organized architecture, and reliable data handling.',
		tools: 'Kotlin · Jetpack Compose · Room',
		href: '/services/android-app-development/',
	},
	{
		number: '03',
		title: 'Backend & integrations',
		text: 'APIs, authentication, databases, and Firebase integrations connecting your interface to its data.',
		tools: 'Node.js · Express · Firebase',
		href: '/services/web-development/',
	},
];

const projects = [
	{
		name: 'NexVion Sportswear',
		type: 'Business website',
		image: '/projects/nexvion-preview.png',
		alt: 'NexVion Sportswear website presenting sportswear manufacturing services',
		description: 'A responsive website presenting a sportswear manufacturer’s products and custom manufacturing services.',
		href: '/projects/nexvion/',
		status: 'Live',
		tone: 'live',
	},
	{
		name: 'DubaiAd',
		type: 'Printing & advertising',
		image: '/projects/dubaiad-preview.png',
		alt: 'DubaiAd printing and advertising website design',
		description: 'A website for printing, signage, and advertising services. Design is ready; images and launch preparation are in progress.',
		href: '/projects/dubaiad/',
		status: 'In progress',
		tone: 'progress',
	},
	{
		name: 'Portfolio Website',
		type: 'Static Astro website',
		image: '/projects/portfolio-preview.png',
		alt: 'Ali Ansar developer portfolio website preview',
		description: 'This Astro portfolio presents my services, project case studies, and ways to discuss a development project.',
		href: '/projects/portfolio/',
		status: 'This site',
		tone: 'neutral',
	},
];

const androidProjects = [
	{
		name: 'CampusNotify',
		initials: 'CN',
		description: 'A campus communication project connecting student and admin experiences.',
		href: '/projects/campusnotify/',
	},
	{
		name: 'Semesta',
		initials: 'SE',
		description: 'An Android project focused on interface design and application state.',
		href: '/projects/semesta/',
	},
	{
		name: 'Flashcard Quiz',
		initials: 'FQ',
		description: 'A study app for creating, organizing, and reviewing flashcards.',
		href: '/projects/flashcard-quiz/',
	},
	{
		name: 'Asterloom',
		initials: 'AS',
		description: 'An Android project exploring navigation and reusable interfaces.',
		href: '/projects/asterloom/',
	},
];

const technologies = [
	'Astro', 'React', 'Next.js', 'Node.js', 'Express',
	'MongoDB', 'Kotlin', 'Jetpack Compose', 'Firebase', 'Room',
];

const steps = [
	{
		number: '01',
		title: 'Define the scope',
		text: 'We discuss your users, required features, resources, and timeline before agreeing on the work.',
	},
	{
		number: '02',
		title: 'Build & review',
		text: 'I develop the interface and features, sharing progress so you can review the project as it takes shape.',
	},
	{
		number: '03',
		title: 'Prepare delivery',
		text: 'We check the agreed functionality and prepare deployment or app delivery according to the scope.',
	},
];
---

<Layout
	title="Web & Android App Development | Ali Ansar"
	description="Hire Ali Ansar for responsive business websites, custom web applications, and native Android apps. Explore project case studies and discuss your requirements."
>
	<main>
		<section class="hero shell" aria-labelledby="hero-title">
			<div class="hero-copy">
				<span class="availability">
					<span aria-hidden="true"></span>Available for freelance projects
				</span>
				<p class="kicker">Ali Ansar · Web & Android Developer</p>
				<h1 id="hero-title">
					Websites & Android apps.
					<em>Built around your goals.</em>
				</h1>
				<p class="hero-description">
					I help businesses and teams turn their requirements into responsive
					websites, custom web applications, and native Android apps.
				</p>
				<div class="actions">
					<a class="button primary" href="/contact/">
						Discuss your project <span aria-hidden="true">↗</span>
					</a>
					<a class="button secondary" href="/projects/">Explore my work</a>
				</div>
				<ul class="hero-points" aria-label="Development focus">
					<li>Responsive interfaces</li>
					<li>Maintainable code</li>
					<li>Backend integration</li>
				</ul>
			</div>

			<aside class="hero-project" aria-labelledby="featured-title">
				<div class="preview-bar">
					<span>Featured website</span>
					<span class="status live">Live</span>
				</div>
				<a
					class="hero-preview"
					href="/projects/nexvion/"
					aria-label="Explore the NexVion Sportswear case study"
				>
					<img
						src="/projects/nexvion-preview.png"
						alt="NexVion Sportswear website homepage"
						loading="eager"
						decoding="async"
					/>
				</a>
				<div class="preview-copy">
					<span class="label">Business website</span>
					<h2 id="featured-title">NexVion Sportswear</h2>
					<p>Presenting products and custom manufacturing services.</p>
					<a class="text-link" href="/projects/nexvion/">
						Explore the case study <span aria-hidden="true">→</span>
					</a>
				</div>
			</aside>
		</section>

		<section class="section shell" aria-labelledby="services-title">
			<div class="section-heading">
				<div>
					<span class="label">Development services</span>
					<h2 id="services-title">What can I help you build?</h2>
				</div>
				<a class="text-link" href="/services/">All services →</a>
			</div>
			<div class="service-grid">
				{services.map((service) => (
					<article class="service-card">
						<span class="number" aria-hidden="true">{service.number}</span>
						<h3>{service.title}</h3>
						<p>{service.text}</p>
						<span class="tools">{service.tools}</span>
						<a
							class="text-link"
							href={service.href}
							aria-label={`Explore ${service.title} services`}
						>
							Explore service <span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</div>
		</section>

		<section class="section shell" aria-labelledby="work-title">
			<div class="section-heading">
				<div>
					<span class="label">Selected web projects</span>
					<h2 id="work-title">See the work behind the services.</h2>
				</div>
				<a class="text-link" href="/projects/">All projects →</a>
			</div>
			<div class="project-grid">
				{projects.map((project) => (
					<article class="project-card">
						<a
							class="project-image"
							href={project.href}
							aria-label={`Explore ${project.name}`}
						>
							<img
								src={project.image}
								alt={project.alt}
								loading="lazy"
								decoding="async"
							/>
							<span class:list={['status', project.tone]}>{project.status}</span>
						</a>
						<div class="project-copy">
							<span class="category">{project.type}</span>
							<h3><a href={project.href}>{project.name}</a></h3>
							<p>{project.description}</p>
							<a
								class="text-link"
								href={project.href}
								aria-label={`Read the ${project.name} case study`}
							>
								Read case study <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="android-band" aria-labelledby="android-title">
			<div class="shell">
				<div class="section-heading">
					<div>
						<span class="label">Android portfolio</span>
						<h2 id="android-title">Native apps. Practical experiences.</h2>
						<p class="section-intro">
							Explore the screenshots and development details in each case study.
						</p>
					</div>
					<a class="text-link" href="/services/android-app-development/">
						Android services →
					</a>
				</div>
				<div class="android-grid">
					{androidProjects.map((project) => (
						<article class="android-card">
							<span class="app-mark" aria-hidden="true">{project.initials}</span>
							<h3><a href={project.href}>{project.name}</a></h3>
							<p>{project.description}</p>
							<a
								class="text-link"
								href={project.href}
								aria-label={`View the ${project.name} app case study`}
							>
								View app project <span aria-hidden="true">→</span>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section shell" aria-labelledby="process-title">
			<div class="section-heading">
				<div>
					<span class="label">Working together</span>
					<h2 id="process-title">A clear path from idea to delivery.</h2>
				</div>
				<a class="text-link" href="/about/">About Ali →</a>
			</div>
			<div class="process-grid">
				{steps.map((step) => (
					<article class="process-card">
						<span class="number" aria-hidden="true">{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="toolkit shell" aria-labelledby="toolkit-title">
			<div>
				<span class="label">Development toolkit</span>
				<h2 id="toolkit-title">Tools chosen to fit your project.</h2>
				<p>The stack depends on your features, data, and maintenance needs.</p>
			</div>
			<ul class="technology-list">
				{technologies.map((technology) => <li>{technology}</li>)}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.shell { width: min(1120px, calc(100% - 3rem)); margin-inline: auto; }
	h1, h2, h3, p { margin-top: 0; }
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
		align-items: center;
		gap: 3rem;
		padding-block: 4.5rem;
	}
	.hero-copy { min-width: 0; }
	.availability {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.7rem;
		border: 1px solid #34d39933;
		border-radius: 999px;
		background: #34d3990a;
		color: #b5e8d9;
		font-size: 0.72rem;
	}
	.availability > span { width: 7px; height: 7px; border-radius: 50%; background: #34d399; }
	.kicker {
		margin: 1.5rem 0 0.8rem;
		color: #75d6ff;
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	.hero h1 {
		margin-bottom: 1.2rem;
		font-size: clamp(2.5rem, 4.1vw, 3.9rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}
	.hero h1 em { display: block; color: var(--color-accent); font-style: normal; }
	.hero-description { max-width: 570px; margin-bottom: 1.5rem; color: var(--color-muted); font-size: 0.98rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 48px;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		font-size: 0.83rem;
		font-weight: 750;
		text-decoration: none;
	}
	.primary { background: var(--color-accent); color: #04111d; }
	.primary:hover { background: #75d6ff; }
	.secondary { border-color: #2c4058; background: #111a29; color: var(--color-text); }
	.secondary:hover { border-color: var(--color-accent); }
	.hero-points {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.72rem;
	}
	.hero-points li::before { content: '✓'; margin-right: 0.4rem; color: #34d399; }
	.hero-project {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #2a4057;
		border-radius: 1.1rem;
		background: var(--color-surface);
		box-shadow: 0 20px 65px #00000033;
	}
	.preview-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--color-border); color: var(--color-muted); font-size: 0.72rem; }
	.hero-preview { display: block; aspect-ratio: 1.55; overflow: hidden; background: #101827; }
	.hero-preview img, .project-image img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
	.preview-copy { padding: 1.25rem; }
	.preview-copy h2 { margin: 0.35rem 0 0.5rem; font-size: 1.2rem; letter-spacing: -0.02em; }
	.preview-copy p { margin-bottom: 0.8rem; color: var(--color-muted); font-size: 0.83rem; }
	.label { color: #75d6ff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
	.section { padding-block: 2rem 3.5rem; }
	.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.6rem; }
	.section-heading h2, .toolkit h2 { margin: 0.5rem 0 0; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -0.035em; }
	.text-link { display: inline-flex; align-items: center; gap: 0.4rem; padding-block: 0.25rem; color: #75d6ff; font-size: 0.8rem; font-weight: 700; text-decoration: none; }
	.text-link:hover { color: #b8edff; text-decoration: underline; text-underline-offset: 4px; }
	.service-grid, .project-grid, .process-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.service-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: linear-gradient(145deg, #101c2d, #0e1624);
	}
	.number { color: #75d6ff; font-size: 0.73rem; font-weight: 750; }
	.service-card h3 { margin: 1rem 0 0.6rem; font-size: 1.13rem; }
	.service-card p, .project-copy p, .android-card p, .process-card p { color: var(--color-muted); font-size: 0.85rem; }
	.tools { margin: auto 0 1rem; color: #bac7d8; font-size: 0.7rem; }
	.project-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--color-border); border-radius: 0.9rem; background: var(--color-surface); }
	.project-image { position: relative; display: block; overflow: hidden; aspect-ratio: 1.65; background: #101827; }
	.status { display: inline-flex; padding: 0.25rem 0.6rem; border: 1px solid transparent; border-radius: 999px; font-size: 0.65rem; font-weight: 750; }
	.project-image .status { position: absolute; top: 0.75rem; left: 0.75rem; }
	.live { border-color: #34d39955; background: #0a211b; color: #76e3ba; }
	.progress { border-color: #fbbf2455; background: #261a0c; color: #ffd092; }
	.neutral { border-color: #38bdf855; background: #0c2032; color: #9adeff; }
	.project-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.3rem; }
	.category { color: var(--color-muted); font-size: 0.67rem; letter-spacing: 0.05em; text-transform: uppercase; }
	.project-copy h3, .android-card h3 { margin: 0.45rem 0 0.6rem; font-size: 1.12rem; }
	.project-copy h3 a, .android-card h3 a { color: var(--color-text); text-decoration: none; }
	.project-copy h3 a:hover, .android-card h3 a:hover { color: #75d6ff; }
	.project-copy .text-link, .android-card .text-link { margin-top: auto; }
	.android-band { margin-block: 1rem; padding-block: 3.5rem; border-block: 1px solid var(--color-border); background: #0b1421; }
	.section-intro { max-width: 620px; margin: 0.8rem 0 0; color: var(--color-muted); font-size: 0.85rem; }
	.android-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
	.android-card { display: flex; flex-direction: column; align-items: flex-start; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 0.9rem; background: var(--color-surface); }
	.app-mark { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 0.7rem; border: 1px solid #38bdf83d; border-radius: 12px; background: #38bdf80d; color: #75d6ff; font-size: 0.8rem; font-weight: 800; }
	.process-card { padding: 1.2rem 1.4rem; border-left: 1px solid #2a4057; }
	.process-card h3 { margin: 0.75rem 0 0.5rem; font-size: 1.05rem; }
	.process-card p { margin-bottom: 0; }
	.toolkit { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; padding: 2rem; margin-block: 1rem 3rem; border: 1px solid var(--color-border); border-radius: 1rem; background: var(--color-surface); }
	.toolkit h2 { font-size: 1.7rem; }
	.toolkit p { margin: 0.8rem 0 0; color: var(--color-muted); font-size: 0.85rem; }
	.technology-list { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
	.technology-list li { padding: 0.4rem 0.7rem; border: 1px solid #2a4057; border-radius: 999px; color: #c5d2e3; font-size: 0.75rem; }
	@media (max-width: 960px) {
		.hero { grid-template-columns: 1fr 1fr; gap: 1.5rem; padding-block: 3rem; }
		.hero h1 { font-size: 2.8rem; }
		.android-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.service-grid, .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.service-card:last-child, .project-card:last-child { grid-column: 1 / -1; }
		.project-card:last-child .project-image { aspect-ratio: 2.2; }
	}
	@media (max-width: 760px) {
		.hero { grid-template-columns: 1fr; gap: 2rem; }
		.hero h1 { max-width: 650px; font-size: clamp(2.7rem, 7vw, 3.5rem); }
		.hero-project { width: 100%; max-width: 600px; }
		.hero-preview { aspect-ratio: 1.8; }
		.process-grid, .toolkit { grid-template-columns: 1fr; }
		.section-heading { align-items: flex-start; flex-direction: column; gap: 0.7rem; }
	}
	@media (max-width: 560px) {
		.shell { width: calc(100% - 2.5rem); }
		.hero { padding-block: 2.5rem; }
		.hero h1 { font-size: clamp(2.4rem, 10vw, 3rem); }
		.actions { flex-direction: column; }
		.service-grid, .project-grid, .android-grid { grid-template-columns: 1fr; }
		.service-card:last-child, .project-card:last-child { grid-column: auto; }
		.project-card:last-child .project-image { aspect-ratio: 1.65; }
		.section { padding-block: 1.5rem 2.5rem; }
		.android-band { padding-block: 2.5rem; }
		.toolkit { padding: 1.4rem; gap: 1.5rem; }
	}
</style>