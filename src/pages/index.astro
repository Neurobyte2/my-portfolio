---
import Layout from '../layouts/Layout.astro';

const services = [
	{ number: '01', title: 'Full-stack websites', text: 'Fast, responsive websites and web apps built around your goals, customers, and brand.' },
	{ number: '02', title: 'Backend & APIs', text: 'Reliable application logic, REST APIs, integrations, authentication, and data flows.' },
	{ number: '03', title: 'Android applications', text: 'Native Android products with thoughtful interfaces, clean architecture, and dependable features.' },
];

const projects = [
	{
		name: 'NexVion Sportswear',
		type: 'Live business website',
		image: '/projects/nexvion-preview.png',
		alt: 'NexVion Sportswear website homepage with a dark layout and green accents',
		description: 'A bold, responsive website for a sportswear manufacturer, presenting its custom apparel and production capabilities to a global audience.',
		href: '/projects/nexvion/',
		status: 'Live',
	},
	{
		name: 'DubaiAd',
		type: 'Printing & advertising website',
		image: '/projects/dubaiad-preview.png',
		alt: 'DubaiAd homepage concept featuring orange accents and a printing services headline',
		description: 'A polished website concept for a printing, signage, and advertising company. The design is ready; the website is not published yet.',
		href: '/projects/dubaiad/',
		status: 'In progress',
	},
	{
		name: 'Portfolio Website',
		type: 'Personal portfolio',
		image: '/projects/portfolio-preview.png',
		alt: 'Ali Ansar portfolio homepage highlighting Android and full-stack engineering',
		description: 'My own portfolio, now growing into a multi-page home for my development services, technical toolkit, and selected work.',
		href: '/projects/portfolio/',
		status: 'This site',
	},
];
---

<Layout
	title="Ali Ansar | Full-Stack Web & Android Developer"
	description="Need a website, web app, or Android product? Ali Ansar builds responsive full-stack websites and polished native Android applications."
>
	<main>
		<section class="hero page-shell">
			<div class="hero-copy">
				<div class="eyebrow"><span class="availability-dot"></span>Available for freelance & remote opportunities</div>
				<p class="hero-kicker">Independent software developer · Web & Android</p>
				<h1>Digital products built to <em>move your business forward.</em></h1>
				<p class="hero-description">I’m Ali Ansar, a full-stack web and Android developer. I turn ideas into useful, well-crafted digital experiences — from the interface people see to the systems that make it work.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/contact/">Tell me about your project <span aria-hidden="true">↗</span></a>
					<a class="button button-secondary" href="/projects/">Explore selected work</a>
				</div>
				<div class="hero-proof"><span>Web & mobile</span><i></i><span>Thoughtful UX</span><i></i><span>End-to-end delivery</span></div>
			</div>
			<div class="hero-card" aria-label="Developer profile">
				<img src="/images/ali-ansar-profile.png" alt="Ali Ansar, software developer" />
				<div class="hero-card-caption">
					<div><span class="availability-dot"></span><strong>Building for the real world</strong></div>
					<span>Ali Ansar · Web · Android</span>
				</div>
			</div>
			<div class="hero-orb" aria-hidden="true"></div>
		</section>

		<section class="services section-shell" aria-labelledby="services-title">
			<div class="section-heading">
				<div><span class="section-label">How I can help</span><h2 id="services-title">One partner, from idea to launch.</h2></div>
				<a class="text-link" href="/services/">Explore all services <span aria-hidden="true">↗</span></a>
			</div>
			<div class="service-grid">
				{services.map((service) => (
					<article class="service-card">
						<span class="service-number">{service.number}</span>
						<h3>{service.title}</h3>
						<p>{service.text}</p>
						<a href="/services/" aria-label={`Learn more about ${service.title}`}>Discover the service <span aria-hidden="true">→</span></a>
					</article>
				))}
			</div>
		</section>

		<section class="work section-shell" aria-labelledby="work-title">
			<div class="section-heading">
				<div><span class="section-label">Selected work</span><h2 id="work-title">Made with purpose.</h2></div>
				<a class="text-link" href="/projects/">Browse all projects <span aria-hidden="true">↗</span></a>
			</div>
			<div class="project-grid">
				{projects.map((project, index) => (
					<article class:list={['project-card', index === 0 && 'project-featured']}>
						<a class="project-image" href={project.href} aria-label={`View ${project.name} project`}>
							<img src={project.image} alt={project.alt} loading="lazy" />
							<span class:list={['project-status', project.status === 'In progress' && 'status-progress']}>{project.status}</span>
						</a>
						<div class="project-info">
							<span class="project-type">{project.type}</span>
							<h3><a href={project.href}>{project.name}</a></h3>
							<p>{project.description}</p>
							<a class="project-link" href={project.href}>View project <span aria-hidden="true">→</span></a>
						</div>
					</article>
				))}
			</div>
			<div class="android-note">
				<div><span class="section-label">Android projects</span><p>Explore mobile products built with Kotlin, Jetpack Compose, and Firebase.</p></div>
				<a class="button button-secondary" href="/projects/">See all projects <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<section class="stack-band" aria-label="Technologies">
			<div class="section-shell stack-inner">
				<span>Tools I build with</span>
				<div class="stack-list"><b>React</b><b>Next.js</b><b>Node.js</b><b>Express</b><b>MongoDB</b><b>Kotlin</b><b>Jetpack Compose</b><b>Firebase</b></div>
			</div>
		</section>

		<section class="closing-cta section-shell">
			<span class="section-label">Have something in mind?</span>
			<h2>Let’s build something<br /><em>worth coming back to.</em></h2>
			<p>Share the challenge, the rough idea, or the product you want to improve. We can figure out the right next step together.</p>
			<a class="button button-primary" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
		</section>
	</main>
</Layout>

<style>
	.page-shell, .section-shell { width: min(1120px, calc(100% - 3rem)); margin-inline: auto; }
	.hero {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		min-height: 620px;
		padding-block: 5rem 6rem;
	}
	.hero-copy { position: relative; z-index: 1; }
	.eyebrow {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.8rem;
		border: 1px solid rgba(56, 189, 248, 0.22);
		border-radius: 999px;
		background: rgba(56, 189, 248, 0.07);
		color: #a8def5;
		font-size: 0.73rem;
		font-weight: 650;
	}
	.availability-dot { display: inline-block; width: 7px; height: 7px; margin-right: 0.5rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 12px #34d39977; }
	.hero-kicker { margin: 1.8rem 0 0.8rem; color: #38bdf8; font-size: 0.76rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
	h1, h2, h3, p { margin-top: 0; }
	.hero h1 { max-width: 720px; margin-bottom: 1.25rem; font-size: clamp(3.4rem, 6.8vw, 5.8rem); line-height: 0.99; letter-spacing: -0.065em; }
	.hero h1 em, .closing-cta h2 em { color: #38bdf8; font-style: normal; }
	.hero-description { max-width: 600px; margin-bottom: 1.8rem; color: #9aa9bd; font-size: 1.03rem; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.button { display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem; min-height: 48px; padding: 0.75rem 1.1rem; border: 1px solid transparent; border-radius: 0.7rem; font-size: 0.84rem; font-weight: 700; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease; }
	.button:hover { transform: translateY(-2px); }
	.button-primary { background: #38bdf8; color: #04111d; }
	.button-primary:hover { background: #67d1ff; }
	.button-secondary { border-color: #26364a; background: #111a29; color: #e2eaf5; }
	.button-secondary:hover { border-color: #38bdf8; }
	.hero-proof { display: flex; align-items: center; gap: 0.8rem; margin-top: 2rem; color: #6f8199; font-size: 0.68rem; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase; }
	.hero-proof i { width: 4px; height: 4px; border-radius: 50%; background: #38bdf8; }
	.hero-card { position: relative; z-index: 1; width: min(100%, 390px); justify-self: center; padding: 0.55rem; border: 1px solid #233348; border-radius: 1.1rem; background: #101827; box-shadow: 0 28px 80px #0007; transform: rotate(1.5deg); }
	.hero-card img { display: block; width: 100%; aspect-ratio: 0.95; border-radius: 0.7rem; object-fit: cover; object-position: center 25%; }
	.hero-card-caption { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.85rem 0.65rem 0.45rem; font-size: 0.72rem; }
	.hero-card-caption div { display: flex; align-items: center; }
	.hero-card-caption .availability-dot { width: 6px; height: 6px; }
	.hero-card-caption > span { padding-left: 1rem; color: #8291a8; }
	.hero-orb { position: absolute; top: 4rem; right: -10%; width: 26rem; height: 26rem; border-radius: 50%; background: radial-gradient(circle, rgba(14, 165, 233, 0.14), transparent 68%); pointer-events: none; }
	.services, .work { padding-block: 2rem 5.5rem; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.7rem; }
	.section-label { color: #38bdf8; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
	.section-heading h2 { margin: 0.45rem 0 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.045em; }
	.text-link, .service-card > a, .project-link { color: #70d5ff; font-size: 0.8rem; font-weight: 700; text-decoration: none; }
	.text-link:hover, .service-card > a:hover, .project-link:hover { color: #b8edff; }
	.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.service-card { min-height: 225px; padding: 1.5rem; border: 1px solid #1d2a3c; border-radius: 0.9rem; background: linear-gradient(145deg, #101827, #0c1320); }
	.service-number { color: #38bdf8; font-size: 0.7rem; font-weight: 800; }
	.service-card h3 { margin: 1.5rem 0 0.55rem; font-size: 1.13rem; letter-spacing: -0.025em; }
	.service-card p { min-height: 4.4rem; margin-bottom: 1.1rem; color: #91a0b5; font-size: 0.85rem; }
	.project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.project-card { overflow: hidden; border: 1px solid #1d2a3c; border-radius: 0.9rem; background: #0e1624; transition: transform 180ms ease, border-color 180ms ease; }
	.project-card:hover { transform: translateY(-4px); border-color: #3a8cad; }
	.project-image { position: relative; display: block; overflow: hidden; background: #101827; }
	.project-image img { display: block; width: 100%; aspect-ratio: 1.65; object-fit: cover; object-position: top; transition: transform 250ms ease; }
	.project-card:hover .project-image img { transform: scale(1.025); }
	.project-status { position: absolute; top: 0.7rem; left: 0.7rem; padding: 0.28rem 0.55rem; border: 1px solid #1a805e88; border-radius: 999px; background: #071b17eF; color: #76e3ba; font-size: 0.65rem; font-weight: 750; }
	.status-progress { border-color: #a8622888; background: #21140deF; color: #ffc27f; }
	.project-info { padding: 1.2rem 1.25rem 1.35rem; }
	.project-type { color: #8293ab; font-size: 0.67rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
	.project-info h3 { margin: 0.35rem 0 0.5rem; font-size: 1.15rem; }
	.project-info h3 a { color: #f1f5f9; text-decoration: none; }
	.project-info p { min-height: 5.2rem; margin-bottom: 0.9rem; color: #9aa9bd; font-size: 0.8rem; line-height: 1.65; }
	.project-link span { padding-left: 0.25rem; }
	.android-note { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 1.25rem; padding: 1.3rem 1.5rem; border: 1px solid #1d2a3c; border-radius: 0.9rem; background: #0b1320; }
	.android-note .section-label { font-size: 0.63rem; }
	.android-note p { margin: 0.3rem 0 0; color: #9aa9bd; font-size: 0.84rem; }
	.stack-band { border-block: 1px solid #192536; background: #0b1320; }
	.stack-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 1.4rem; }
	.stack-inner > span { flex: 0 0 auto; color: #8190a5; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; }
	.stack-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.6rem; }
	.stack-list b { padding: 0.35rem 0.65rem; border: 1px solid #1f3043; border-radius: 999px; color: #bac7d8; font-size: 0.68rem; font-weight: 600; }
	.closing-cta { padding-block: 6.5rem 7rem; text-align: center; }
	.closing-cta h2 { margin: 0.65rem 0 0.8rem; font-size: clamp(2.5rem, 5vw, 4.4rem); line-height: 1.03; letter-spacing: -0.055em; }
	.closing-cta p { max-width: 540px; margin: 0 auto 1.5rem; color: #97a6ba; font-size: 0.92rem; }
	@media (max-width: 850px) {
		.hero { grid-template-columns: 1fr; min-height: auto; padding-block: 4rem 5rem; }
		.hero-card { max-width: 540px; margin-inline: auto; transform: none; }
		.hero-orb { top: 10rem; right: -20%; }
		.service-grid { grid-template-columns: 1fr 1fr; }
		.service-card:last-child { grid-column: 1 / -1; min-height: auto; }
		.project-grid { grid-template-columns: 1fr 1fr; }
		.project-card:last-child { grid-column: 1 / -1; }
		.project-card:last-child .project-image img { aspect-ratio: 2.2; }
		.stack-inner { align-items: flex-start; flex-direction: column; gap: 0.8rem; }
		.stack-list { justify-content: flex-start; }
	}
	@media (max-width: 560px) {
		.page-shell, .section-shell { width: min(100% - 2.5rem, 1120px); }
		.hero { gap: 2rem; padding-block: 3.4rem 3.7rem; }
		.hero h1 { font-size: clamp(3.05rem, 13vw, 4rem); }
		.hero-kicker { margin-top: 1.4rem; font-size: 0.65rem; }
		.hero-description { font-size: 0.94rem; }
		.hero-actions { align-items: stretch; flex-direction: column; }
		.hero-proof { flex-wrap: wrap; font-size: 0.59rem; }
		.section-heading { align-items: flex-start; flex-direction: column; }
		.section-heading h2 { font-size: 2.1rem; }
		.services, .work { padding-bottom: 3.8rem; }
		.service-grid, .project-grid { grid-template-columns: 1fr; }
		.service-card:last-child, .project-card:last-child { grid-column: auto; }
		.project-card:last-child .project-image img { aspect-ratio: 1.65; }
		.service-card { min-height: auto; }
		.service-card p, .project-info p { min-height: auto; }
		.android-note { align-items: flex-start; flex-direction: column; }
		.closing-cta { padding-block: 4.5rem 5rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html) { scroll-behavior: auto; }
		*, *::before, *::after { transition-duration: 0.01ms !important; }
	}
</style>
