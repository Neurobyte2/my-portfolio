---
import Layout from '../layouts/Layout.astro';

const principles = [
	{
		number: '01',
		title: 'Understand the requirements',
		text: 'Start with the users, important tasks, and project constraints before choosing the features or technology.',
	},
	{
		number: '02',
		title: 'Keep the code organized',
		text: 'Use clear structure and reusable components so features are easier to maintain and improve.',
	},
	{
		number: '03',
		title: 'Consider the complete experience',
		text: 'Plan responsive layouts, navigation, loading states, and error handling alongside the main features.',
	},
];

const capabilities = [
	{
		title: 'Web development',
		description: 'Business websites, custom web applications, and backend integrations.',
		tools: ['Astro', 'React', 'Next.js', 'Node.js', 'Express', 'MongoDB'],
		href: '/services/web-development/',
		link: 'Explore web development',
	},
	{
		title: 'Android development',
		description: 'Native applications with organized UI, state management, and data layers.',
		tools: ['Kotlin', 'Jetpack Compose', 'MVVM', 'Room', 'Firebase'],
		href: '/services/android-app-development/',
		link: 'Explore Android development',
	},
];

const featuredProjects = [
	{
		name: 'NexVion Sportswear',
		type: 'Live business website',
		href: '/projects/nexvion/',
	},
	{
		name: 'DubaiAd',
		type: 'Printing website · In progress',
		href: '/projects/dubaiad/',
	},
	{
		name: 'Flashcard Quiz',
		type: 'Android study app',
		href: '/projects/flashcard-quiz/',
	},
];
---

<Layout
	title="About Ali Ansar | Web & Android Developer"
	description="Meet Ali Ansar, a web and Android developer building business websites, custom web applications, and native apps with Kotlin and Jetpack Compose."
>
	<main class="about-shell">
		<header class="about-hero">
			<div class="hero-copy">
				<span class="section-label">About Ali Ansar</span>
				<h1>
					A developer for your
					<em>web & Android projects.</em>
				</h1>
				<p class="intro">
					I’m Ali Ansar. I enjoy turning project requirements into useful
					websites and applications with clear interfaces and organized code.
				</p>
				<p>
					My work spans business websites, full-stack web applications,
					and native Android apps. I focus on both the experience people use
					and the data and application logic that support it.
				</p>
				<div class="actions">
					<a class="button primary" href="/contact/">
						Discuss your project <span aria-hidden="true">↗</span>
					</a>
					<a class="button secondary" href="/projects/">Explore my work</a>
				</div>
			</div>

			<figure class="portrait">
				<div class="portrait-image">
					<img
						src="/images/ali-ansar-profile.png"
						alt="Ali Ansar, web and Android developer"
						loading="eager"
						decoding="async"
					/>
				</div>
				<figcaption>
					<strong>Ali Ansar</strong>
					<span>Web & Android Developer</span>
				</figcaption>
			</figure>
		</header>

		<section class="section" aria-labelledby="principles-title">
			<span class="section-label">How I approach development</span>
			<h2 id="principles-title">Practical decisions at every layer.</h2>
			<div class="principle-grid">
				{principles.map((principle) => (
					<article class="principle-card">
						<span class="number" aria-hidden="true">{principle.number}</span>
						<h3>{principle.title}</h3>
						<p>{principle.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="capabilities-title">
			<span class="section-label">What I build</span>
			<h2 id="capabilities-title">Across websites and mobile apps.</h2>
			<p class="section-intro">
				The tools and architecture depend on the features, data,
				and maintenance needs of each project.
			</p>
			<div class="capability-grid">
				{capabilities.map((capability) => (
					<article class="capability-card">
						<h3>{capability.title}</h3>
						<p>{capability.description}</p>
						<ul
							class="technology-list"
							aria-label={`${capability.title} technologies`}
						>
							{capability.tools.map((tool) => <li>{tool}</li>)}
						</ul>
						<a class="text-link" href={capability.href}>
							{capability.link} <span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</div>
		</section>

		<section class="work-panel section" aria-labelledby="work-title">
			<div>
				<span class="section-label">See the work</span>
				<h2 id="work-title">Explore project case studies.</h2>
				<p>
					See examples of the interfaces and features I have worked on,
					along with project screenshots and development details.
				</p>
				<a class="text-link" href="/projects/">
					Browse all projects <span aria-hidden="true">→</span>
				</a>
			</div>
			<ul class="project-list">
				{featuredProjects.map((project) => (
					<li>
						<a href={project.href}>
							<span>
								<strong>{project.name}</strong>
								<small>{project.type}</small>
							</span>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.about-shell {
		width: min(1120px, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 4rem;
	}
	h1, h2, h3, p { margin-top: 0; }
	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr);
		align-items: center;
		gap: 3.5rem;
	}
	.section-label {
		color: #75d6ff;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.about-hero h1 {
		margin: 0.75rem 0 1.2rem;
		font-size: clamp(2.6rem, 4.5vw, 4.2rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}
	.about-hero h1 em {
		display: block;
		color: var(--color-accent);
		font-style: normal;
	}
	.hero-copy p {
		max-width: 650px;
		color: var(--color-muted);
		font-size: 0.93rem;
	}
	.hero-copy .intro { color: #dce7f5; font-size: 1.02rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 48px;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		font-size: 0.83rem;
		font-weight: 750;
		text-decoration: none;
	}
	.primary { background: var(--color-accent); color: #04111d; }
	.primary:hover { background: #75d6ff; }
	.secondary { border-color: #2c4058; background: #111a29; color: var(--color-text); }
	.secondary:hover { border-color: var(--color-accent); }
	.portrait {
		overflow: hidden;
		margin: 0;
		border: 1px solid #2a4057;
		border-radius: 1rem;
		background: var(--color-surface);
	}
	.portrait-image { aspect-ratio: 0.9; background: #101827; }
	.portrait-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}
	.portrait figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 1.25rem;
		border-top: 1px solid var(--color-border);
	}
	.portrait strong { font-size: 0.95rem; }
	.portrait figcaption > span { color: var(--color-muted); font-size: 0.78rem; }
	.section { margin-top: 4rem; }
	h2 {
		margin: 0.5rem 0 1.5rem;
		font-size: clamp(1.8rem, 3.2vw, 2.5rem);
		line-height: 1.2;
		letter-spacing: -0.035em;
	}
	.principle-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.principle-card, .capability-card {
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: var(--color-surface);
	}
	.number { color: #75d6ff; font-size: 0.73rem; font-weight: 750; }
	.principle-card h3 { margin: 1rem 0 0.6rem; font-size: 1.08rem; }
	.principle-card p { margin-bottom: 0; color: var(--color-muted); font-size: 0.85rem; }
	.section-intro { max-width: 700px; margin-top: -0.5rem; color: var(--color-muted); font-size: 0.9rem; }
	.capability-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.capability-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		background: linear-gradient(145deg, #101c2d, #0e1624);
	}
	.capability-card h3 { margin-bottom: 0.6rem; font-size: 1.15rem; }
	.capability-card p { color: var(--color-muted); font-size: 0.85rem; }
	.technology-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: auto 0 1.25rem;
		padding: 0;
		list-style: none;
	}
	.technology-list li {
		padding: 0.35rem 0.6rem;
		border: 1px solid #2a4057;
		border-radius: 999px;
		color: #c5d2e3;
		font-size: 0.7rem;
	}
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding-block: 0.25rem;
		color: #75d6ff;
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}
	.text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
	.work-panel {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 2.5rem;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: #0d1725;
	}
	.work-panel h2 { margin-bottom: 0.8rem; }
	.work-panel p { color: var(--color-muted); font-size: 0.86rem; }
	.project-list { margin: 0; padding: 0; list-style: none; }
	.project-list li + li { border-top: 1px solid var(--color-border); }
	.project-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0.5rem;
		border-radius: 0.5rem;
		color: var(--color-text);
		text-decoration: none;
	}
	.project-list a:hover { background: #142033; }
	.project-list strong { display: block; font-size: 0.9rem; }
	.project-list small { display: block; margin-top: 0.3rem; color: var(--color-muted); font-size: 0.75rem; }
	.arrow { color: #75d6ff; }
	@media (max-width: 850px) {
		.about-hero { gap: 2rem; }
		.principle-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 700px) {
		.about-hero { grid-template-columns: 1fr; }
		.portrait { width: 100%; max-width: 420px; }
		.capability-grid, .work-panel { grid-template-columns: 1fr; }
	}
	@media (max-width: 560px) {
		.about-shell { width: calc(100% - 2.5rem); padding-block: 2.5rem 3rem; }
		.actions { flex-direction: column; }
		.section { margin-top: 3rem; }
		.work-panel { padding: 1.3rem; gap: 1.5rem; }
	}
</style>