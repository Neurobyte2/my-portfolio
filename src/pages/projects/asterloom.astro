		{ title: 'Structured navigation', text: 'Screen responsibilities and navigation are organized around clear application flows.' },
	]}
	technologies={['Kotlin', 'Jetpack Compose', 'MVVM', 'Clean Architecture', 'Dependency Injection', 'Material Design']}
