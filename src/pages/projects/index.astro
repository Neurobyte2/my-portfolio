---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import nexvionPreview from '../../assets/projects/nexvion-preview.png';
import dubaiadPreview from '../../assets/projects/dubaiad-preview.png';
import portfolioPreview from '../../assets/projects/portfolio-preview.png';

const webProjects = [
	{
		title: 'NexVion Sportswear',
		category: 'Live business website',
		image: nexvionPreview,
		alt: 'NexVion Sportswear homepage showcasing custom sportswear manufacturing',
		text: 'A modern business website for a sportswear manufacturer, presenting its products and custom manufacturing capabilities.',
		href: '/projects/nexvion/',
		status: 'Live',
	},
	{
		title: 'DubaiAd',
		category: 'Printing & advertising',
		image: dubaiadPreview,
		alt: 'DubaiAd website design for printing, signage, and advertising services',
		text: 'A website for printing and signage services. The design is complete; resource preparation and launch are in progress.',
		href: '/projects/dubaiad/',
		status: 'In progress',
	},
	{
		title: 'Portfolio Website',
		category: 'Personal portfolio',
		image: portfolioPreview,
		alt: 'Ali Ansar portfolio website preview',
		text: 'My own portfolio: a multi-page presentation of development services, selected projects, and ways to get in touch.',
		href: '/projects/portfolio/',
		status: 'This site',
	},
];

const androidProjects = [
	{
		title: 'CampusNotify',
		initials: 'CN',
		text: 'A campus communication platform bringing student and admin experiences together.',
		href: '/projects/campusnotify/',
		stack: 'Kotlin · Firebase · MVVM',
	},
	{
		title: 'Semesta',
		initials: 'SE',
		text: 'A native Android app focused on polished UI, modular design, and predictable state.',
		href: '/projects/semesta/',
		stack: 'Kotlin · Jetpack Compose · Clean Architecture',
	},
	{
		title: 'Flashcard Quiz',
		initials: 'FQ',
		text: 'An offline-friendly study app for creating, organizing, and reviewing flashcards.',
		href: '/projects/flashcard-quiz/',
		stack: 'Jetpack Compose · Room · Hilt',
	},
	{
		title: 'Asterloom',
		initials: 'AS',
		text: 'An Android application exploring focus sessions, interface customization, and reusable components.',
		href: '/projects/asterloom/',
		stack: 'Kotlin · Jetpack Compose · MVVM',
	},
];
---

<Layout
	title="Projects | Ali Ansar Web & Android Portfolio"
	description="Explore websites and Android applications by Ali Ansar, including NexVion Sportswear, DubaiAd, CampusNotify, and Flashcard Quiz."
>
	<main class="projects-shell">
		<header class="projects-hero">
			<span class="section-label">Selected work</span>
			<h1>Work built for <em>real people and real goals.</em></h1>
			<p>
				A selection of web and Android projects — from a live business
				website to products and concepts in progress.
			</p>
			<nav class="project-categories" aria-label="Project categories">
				<a href="#web-title">Web projects <span>03</span></a>
				<a href="#android-title">Android apps <span>04</span></a>
			</nav>
		</header>

		<section aria-labelledby="web-title">
			<div class="section-heading">
				<span class="section-label">Web projects</span>
				<h2 id="web-title">Websites & digital experiences.</h2>
			</div>

			<div class="web-grid">
				{webProjects.map((project, index) => (
					<article class="web-card">
						<a
							class="web-image"
							href={project.href}
							aria-label={`Explore ${project.title}`}
						>
							<Image
								src={project.image}
								alt={project.alt}
								width={800}
								widths={[320, 480, 640, 800, 960, 1200]}
								sizes={index === 2
									? '(max-width: 560px) calc(100vw - 2.5rem), (max-width: 850px) calc(100vw - 3rem), (max-width: 1168px) calc((100vw - 5rem) / 3), 363px'
									: '(max-width: 560px) calc(100vw - 2.5rem), (max-width: 850px) calc((100vw - 4rem) / 2), (max-width: 1168px) calc((100vw - 5rem) / 3), 363px'}
								format="webp"
								quality={80}
								loading="lazy"
								decoding="async"
							/>
							<span
								class:list={[
									'status',
									project.status === 'In progress' && 'status-progress',
									project.status === 'This site' && 'status-neutral',
								]}
							>
								{project.status}
							</span>
						</a>

						<div class="web-copy">
							<span class="category">{project.category}</span>
							<h3><a href={project.href}>{project.title}</a></h3>
							<p>{project.text}</p>
							<a
								class="project-link"
								href={project.href}
								aria-label={`View ${project.title} project details`}
							>
								View project details <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="android-section" aria-labelledby="android-title">
			<div class="section-heading">
				<span class="section-label">Android applications</span>
				<h2 id="android-title">Mobile products with purpose.</h2>
			</div>

			<div class="android-grid">
				{androidProjects.map((project) => (
					<article class="android-card">
						<span class="android-mark" aria-hidden="true">
							{project.initials}
						</span>
						<h3><a href={project.href}>{project.title}</a></h3>
						<p>{project.text}</p>
						<span class="android-stack">{project.stack}</span>
						<a
							class="project-link"
							href={project.href}
							aria-label={`Read the ${project.title} case study`}
						>
							Read case study <span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	.projects-shell {
		width: min(1120px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 4.2rem 0 5rem;
	}
	.section-label {
		color: #75d6ff;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h1, h2, h3, p { margin-top: 0; }
	.projects-hero { max-width: 780px; margin-bottom: 3.3rem; }
	.projects-hero h1 {
		margin: 0.55rem 0 0.9rem;
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		line-height: 1.08;
		letter-spacing: -0.05em;
	}
	.projects-hero h1 em {
		display: block;
		color: #38bdf8;
		font-style: normal;
	}
	.projects-hero p {
		max-width: 650px;
		color: var(--color-muted);
		font-size: 0.98rem;
	}
	.project-categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.4rem;
	}
	.project-categories a {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		min-height: 44px;
		padding: 0.6rem 0.9rem;
		border: 1px solid #294057;
		border-radius: 0.65rem;
		background: #0e1624;
		color: #dce7f5;
		font-size: 0.8rem;
		font-weight: 650;
		text-decoration: none;
	}
	.project-categories a:hover { border-color: #38bdf8; }
	.project-categories span { color: #75d6ff; font-size: 0.7rem; }
	.section-heading { margin-bottom: 1.4rem; }
	.section-heading h2 {
		margin: 0.45rem 0 0;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.2;
		letter-spacing: -0.045em;
	}
	.web-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.web-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid #1d2a3c;
		border-radius: 0.9rem;
		background: #0e1624;
		transition: transform 180ms ease, border-color 180ms ease;
	}
	.web-card:hover { transform: translateY(-3px); border-color: #3a8cad; }
	.web-image {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 1.65;
		background: #111827;
	}
	.web-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 200ms ease;
	}
	.web-card:hover .web-image :global(img) { transform: scale(1.025); }
	.status {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		padding: 0.28rem 0.55rem;
		border: 1px solid #1a805e88;
		border-radius: 999px;
		background: #071b17ef;
		color: #76e3ba;
		font-size: 0.65rem;
		font-weight: 750;
	}
	.status-progress {
		border-color: #a8622888;
		background: #21140def;
		color: #ffc27f;
	}
	.status-neutral {
		border-color: #38bdf855;
		background: #0c2032;
		color: #9adeff;
	}
	.web-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.1rem 1.2rem 1.3rem;
	}
	.category {
		color: var(--color-muted);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.web-copy h3, .android-card h3 { margin: 0.4rem 0; font-size: 1.12rem; }
	.web-copy h3 a, .android-card h3 a { color: #f1f5f9; text-decoration: none; }
	.web-copy h3 a:hover, .android-card h3 a:hover { color: #75d6ff; }
	.web-copy p, .android-card p {
		margin-bottom: 1rem;
		color: var(--color-muted);
		font-size: 0.83rem;
	}
	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		color: #75d6ff;
		font-size: 0.79rem;
		font-weight: 700;
		text-decoration: none;
	}
	.web-copy .project-link { margin-top: auto; }
	.android-section { margin-top: 5rem; }
	.android-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.8rem;
	}
	.android-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.2rem;
		border: 1px solid #1d2a3c;
		border-radius: 0.85rem;
		background: #0e1624;
	}
	.android-mark {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		margin-bottom: 0.9rem;
		border: 1px solid #264159;
		border-radius: 0.7rem;
		background: #132234;
		color: #71d4ff;
		font-size: 0.75rem;
		font-weight: 800;
	}
	.android-card h3 { margin-top: 0; }
	.android-stack {
		margin: auto 0 0.6rem;
		color: var(--color-muted);
		font-size: 0.7rem;
	}
	@media (max-width: 850px) {
		.web-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.web-card:last-child { grid-column: 1 / -1; }
		.web-card:last-child .web-image { aspect-ratio: 2.2; }
		.android-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.projects-shell { width: calc(100% - 2.5rem); padding-top: 3rem; }
		.web-grid, .android-grid { grid-template-columns: 1fr; }
		.web-card:last-child { grid-column: auto; }
		.web-card:last-child .web-image { aspect-ratio: 1.65; }
		.android-section { margin-top: 3.5rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.web-card, .web-image :global(img) { transition: none; }
		.web-card:hover, .web-card:hover .web-image :global(img) { transform: none; }
	}
</style>