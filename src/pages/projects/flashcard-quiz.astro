---
import AndroidShowcase from '../../components/AndroidShowcase.astro';
---

<AndroidShowcase
	title="Flashcard Quiz"
	project="flashcard-quiz"
	badge="Offline learning app"
	focus="Flashcards & quiz revision"
	description="An offline Android study app for creating, organizing, and reviewing flashcards, built with Kotlin, Jetpack Compose, and Room."
	problem="Students need a lightweight way to create personal study material and review important concepts without a complicated workflow."
	solution="The app combines flashcard creation, local storage, browsing, and quiz revision. Room keeps study material available without a remote backend."
	features={[
		{ title: 'Create & edit flashcards', text: 'Build personal study material and update saved cards as needed.' },
		{ title: 'Offline storage', text: 'Store flashcards locally with Room so saved material remains available without an internet connection.' },
		{ title: 'Review & quiz', text: 'Browse saved cards and use an interactive quiz experience for revision.' },
		{ title: 'Focused navigation', text: 'Move between creation, collection, review, and quiz screens through a structured flow.' },
	]}
	technologies={['Kotlin', 'Jetpack Compose', 'Room', 'Hilt', 'Navigation', 'MVVM', 'Clean Architecture']}
	architecture={[
		{ title: 'Presentation & domain', text: 'Compose screens and ViewModels manage the interface, while use cases and models organize application logic.' },
		{ title: 'Local data & dependencies', text: 'Room, DAOs, and repositories handle persistence. Hilt provides dependencies across application layers.' },
	]}
	learnings={[
		'Coordinating Room operations with responsive UI state.',
		'Designing focused flashcard review and quiz interactions.',
		'Separating persistence, application logic, and Compose interfaces.',
	]}
	outcome="The project demonstrates an offline learning workflow using local persistence, organized application layers, and native Android interfaces."
	screenshots={[
		{ file: 'flashcard-ss-1.jpeg', alt: 'Flashcard Quiz home screen', caption: 'Track your study cards' },
		{ file: 'flashcard-ss-2.jpeg', alt: 'Flashcard Quiz review screen', caption: 'Flip and review cards' },
	]}
/>