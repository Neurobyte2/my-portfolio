---
import Layout from '../layouts/Layout.astro';

const email = 'aliedits1129@gmail.com';
const phone = '+923479951664';
const displayPhone = '+92 347 9951664';

const message =
	'Hello Ali, I would like to discuss a development project.\n\n' +
	'Project type:\nRequired features:\nExpected timeline:\nApproximate budget:\n';

const emailURL =
	`mailto:${email}?subject=${encodeURIComponent('Development project inquiry')}` +
	`&body=${encodeURIComponent(message)}`;

const whatsappURL =
	`https://wa.me/923479951664?text=${encodeURIComponent(message)}`;

const services = [
	{ title: 'Website or web application', href: '/services/web-development/' },
	{ title: 'Native Android application', href: '/services/android-app-development/' },
	{ title: 'Backend or API integration', href: '/services/web-development/' },
	{ title: 'Existing project improvements', href: '/services/' },
];

const briefItems = [
	{
		title: 'Your project',
		text: 'What do you want to build, and who will use it?',
	},
	{
		title: 'Required features',
		text: 'List the important pages, screens, or tasks the product should support.',
	},
	{
		title: 'Timeline & budget',
		text: 'Share your preferred delivery date and an approximate budget, if available.',
	},
	{
		title: 'Existing resources',
		text: 'Mention any designs, content, existing website, app, or backend you already have.',
	},
];
---

<Layout
	title="Contact Ali Ansar | Web & Android Development"
	description="Contact Ali Ansar by email, WhatsApp, or phone to discuss a website, web application, Android app, or development opportunity."
>
	<main class="contact-shell">
		<header class="contact-hero">
			<span class="section-label">Contact Ali Ansar</span>
			<h1>
				Have a project in mind?
				<em>Let’s discuss the details.</em>
			</h1>
			<p>
				Whether you need a business website, a custom web application,
				or an Android app, share your requirements and we can discuss
				a practical next step.
			</p>
		</header>

		<div class="contact-layout">
			<section class="contact-card" aria-labelledby="contact-title">
				<span class="availability">
					<span aria-hidden="true"></span>
					Available for freelance & remote opportunities
				</span>
				<h2 id="contact-title">Choose how you’d like to connect.</h2>
				<p>
					Email works well for a detailed project brief.
					WhatsApp is another way to start the conversation.
				</p>

				<div class="contact-actions">
					<a class="button primary" href={emailURL}>
						Send an email <span aria-hidden="true">↗</span>
					</a>
					<a
						class="button whatsapp"
						href={whatsappURL}
						target="_blank"
						rel="noopener noreferrer"
					>
						Message on WhatsApp <span aria-hidden="true">↗</span>
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</div>

				<div class="contact-details">
					<a class="detail-link" href={`mailto:${email}`}>
						<span>
							<small>Email</small>
							<strong>{email}</strong>
						</span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
					<a class="detail-link" href={`tel:${phone}`}>
						<span>
							<small>Call Ali</small>
							<strong>{displayPhone}</strong>
						</span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				</div>

				<nav class="social-links" aria-label="Professional profiles">
					<a
						href="https://github.com/Neurobyte2"
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub <span aria-hidden="true">↗</span>
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
					<a
						href="https://www.linkedin.com/in/ali-ansar-536153366"
						target="_blank"
						rel="noopener noreferrer"
					>
						LinkedIn <span aria-hidden="true">↗</span>
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</nav>
			</section>

			<aside class="brief-card" aria-labelledby="brief-title">
				<span class="section-label">A useful starting point</span>
				<h2 id="brief-title">What should you share?</h2>
				<p>
					A short message is enough to start. These details help me
					understand the work you need.
				</p>
				<ol class="brief-list">
					{briefItems.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))}
				</ol>
				<p class="brief-note">
					Still deciding on the features? Explain the problem you
					want to solve.
				</p>
			</aside>
		</div>

		<section class="services-panel" aria-labelledby="services-title">
			<div>
				<span class="section-label">Explore before you inquire</span>
				<h2 id="services-title">Find the service that fits your project.</h2>
				<p>
					Review the development options, or see project case studies
					for examples of my work.
				</p>
				<a class="text-link" href="/projects/">
					View project case studies <span aria-hidden="true">→</span>
				</a>
			</div>
			<ul class="service-list">
				{services.map((service) => (
					<li>
						<a href={service.href}>
							{service.title} <span aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.contact-shell {
		width: min(1120px, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 4rem;
	}
	h1, h2, h3, p { margin-top: 0; }
	.section-label {
		color: #75d6ff;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.contact-hero { max-width: 900px; margin-bottom: 2.5rem; }
	.contact-hero h1 {
		margin: 0.75rem 0 1.2rem;
		font-size: clamp(2.6rem, 5vw, 4.5rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}
	.contact-hero h1 em {
		display: block;
		color: var(--color-accent);
		font-style: normal;
	}
	.contact-hero > p {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.98rem;
	}
	.contact-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 1.25rem;
		align-items: start;
	}
	.contact-card, .brief-card {
		min-width: 0;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}
	.contact-card { background: linear-gradient(145deg, #101c2d, #0e1624); }
	.availability {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		color: #b5e8d9;
		font-size: 0.72rem;
	}
	.availability > span {
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 50%;
		background: #34d399;
	}
	.contact-card h2, .brief-card h2 {
		margin: 0.5rem 0 0.8rem;
		font-size: 1.65rem;
		line-height: 1.25;
		letter-spacing: -0.03em;
	}
	.contact-card > p, .brief-card > p {
		color: var(--color-muted);
		font-size: 0.87rem;
	}
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block: 1.5rem;
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 48px;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		font-size: 0.82rem;
		font-weight: 750;
		text-decoration: none;
	}
	.primary { background: var(--color-accent); color: #04111d; }
	.primary:hover { background: #75d6ff; }
	.whatsapp { border-color: #34d39966; background: #103127; color: #b7f5dd; }
	.whatsapp:hover { border-color: #34d399; background: #154333; }
	.contact-details { display: grid; gap: 0.75rem; }
	.detail-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid #2a4057;
		border-radius: 0.75rem;
		color: var(--color-text);
		text-decoration: none;
	}
	.detail-link:hover { border-color: var(--color-accent); background: #142033; }
	.detail-link > span:first-child { min-width: 0; }
	.detail-link small { display: block; margin-bottom: 0.3rem; color: var(--color-muted); font-size: 0.72rem; }
	.detail-link strong { font-size: 0.9rem; overflow-wrap: anywhere; }
	.arrow { color: #75d6ff; }
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}
	.social-links a, .text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 40px;
		color: #75d6ff;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}
	.social-links a:hover, .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
	.brief-list {
		display: grid;
		gap: 1.1rem;
		margin: 1.5rem 0;
		padding-left: 1.3rem;
	}
	.brief-list li { padding-left: 0.3rem; }
	.brief-list li::marker { color: #75d6ff; font-size: 0.8rem; font-weight: 750; }
	.brief-list h3 { margin-bottom: 0.3rem; font-size: 0.9rem; }
	.brief-list p { margin-bottom: 0; color: var(--color-muted); font-size: 0.8rem; }
	.brief-card .brief-note { margin-bottom: 0; padding-top: 1rem; border-top: 1px solid var(--color-border); font-size: 0.8rem; }
	.services-panel {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 2.5rem;
		margin-top: 3rem;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: #0d1725;
	}
	.services-panel h2 { margin: 0.5rem 0 0.8rem; font-size: 1.8rem; line-height: 1.25; letter-spacing: -0.035em; }
	.services-panel p { color: var(--color-muted); font-size: 0.85rem; }
	.service-list { margin: 0; padding: 0; list-style: none; }
	.service-list li + li { border-top: 1px solid var(--color-border); }
	.service-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 52px;
		padding: 0.75rem 0.5rem;
		border-radius: 0.5rem;
		color: var(--color-text);
		font-size: 0.85rem;
		text-decoration: none;
	}
	.service-list a:hover { background: #142033; color: #75d6ff; }
	.service-list a span { color: #75d6ff; }
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 850px) {
		.contact-layout, .services-panel { grid-template-columns: 1fr; }
	}
	@media (max-width: 560px) {
		.contact-shell { width: calc(100% - 2.5rem); padding-block: 2.5rem 3rem; }
		.contact-card, .brief-card, .services-panel { padding: 1.3rem; }
		.contact-actions { flex-direction: column; }
		.services-panel { gap: 1.5rem; }
	}
</style>