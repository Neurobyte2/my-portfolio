---
import Layout from '../../layouts/Layout.astro';

const services = [
	{
		title: 'Business websites',
		text: 'Present your business, services, and work through a responsive website with clear contact options.',
		items: ['Service and company pages', 'Project or product galleries', 'Email and WhatsApp inquiry links'],
	},
	{
		title: 'Custom web applications',
		text: 'Build an application around the tasks your users need to complete, with interfaces and data flows planned together.',
		items: ['Dashboards and management tools', 'User accounts and authentication', 'Forms, validation, and data management'],
	},
	{
		title: 'Backend & API integration',
		text: 'Connect your website or application to the data and services it needs.',
		items: ['Node.js and Express APIs', 'Database integration', 'Loading states and error handling'],
	},
	{
		title: 'Existing website improvements',
		text: 'Improve an existing project after reviewing its code, current issues, and your priorities.',
		items: ['Mobile layout and navigation fixes', 'Image and performance improvements', 'Technical SEO foundations'],
	},
];

const projects = [
	{
		title: 'NexVion Sportswear',
		status: 'Live website',
		image: '/projects/nexvion-preview.png',
		alt: 'NexVion Sportswear business website preview',
		text: 'A business website presenting sportswear products and custom manufacturing services.',
		href: '/projects/nexvion/',
	},
	{
		title: 'DubaiAd',
		status: 'In progress',
		image: '/projects/dubaiad-preview.png',
		alt: 'DubaiAd printing and advertising website design',
		text: 'A printing and advertising website with a completed design and launch preparation in progress.',
		href: '/projects/dubaiad/',
	},
];

const questions = [
	{
		title: 'Which technology will you use for my website?',
		text: 'The choice depends on your requirements. A content-focused website may use Astro, while a web application may use React or Next.js with backend services where needed.',
	},
	{
		title: 'What do I need to provide?',
		text: 'Share your business details, required pages or features, logo, content, images, and any reference websites. We can identify missing resources when defining the scope.',
	},
	{
		title: 'Are domain and hosting costs included?',
		text: 'Domain registration and any paid hosting or external services are separate costs unless explicitly included in the agreed scope. Ownership and account access should be agreed before launch.',
	},
	{
		title: 'Will my website appear on Google?',
		text: 'Technical SEO can help search engines discover and understand your pages. Indexing and rankings are decided by Google and cannot be guaranteed.',
	},
	{
		title: 'Can you add a dashboard or contact form?',
		text: 'Yes, depending on the requirements. A working submission form needs a form service or backend, while a dashboard may also need authentication and a database. These features are scoped separately.',
	},
];
---

<Layout
	title="Website & Full-Stack Web Development | Ali Ansar"
	description="Hire Ali Ansar for responsive business websites, custom web applications, backend APIs, and website improvements. Explore projects and discuss your requirements."
>
	<main class="web-page">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/services/">Services</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">Web development</span>
		</nav>

		<header class="hero">
			<span class="eyebrow">Website & web application services</span>
			<h1>
				Web development for
				<em>your business and your users.</em>
			</h1>
			<p>
				I’m Ali Ansar. I build responsive business websites and custom web
				applications that explain your services, support your workflows,
				and make the next step clear for your customers.
			</p>
			<div class="actions">
				<a class="button primary" href="/contact/">
					Discuss your website <span aria-hidden="true">↗</span>
				</a>
				<a class="button secondary" href="#web-projects">
					Explore website projects
				</a>
			</div>
			<ul class="hero-points" aria-label="Development priorities">
				<li>Responsive layouts</li>
				<li>Clear navigation</li>
				<li>Maintainable code</li>
			</ul>
		</header>

		<section aria-labelledby="services-title">
			<span class="eyebrow">What I can help with</span>
			<h2 id="services-title">A website or application built around your goals.</h2>
			<p class="section-intro">
				We agree on the pages, features, integrations, and delivery scope
				before development begins.
			</p>
			<div class="service-grid">
				{services.map((service) => (
					<article class="card">
						<h3>{service.title}</h3>
						<p>{service.text}</p>
						<ul class="feature-list">
							{service.items.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section id="web-projects" class="section" aria-labelledby="projects-title">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Selected projects</span>
					<h2 id="projects-title">See examples of my website work.</h2>
				</div>
				<a class="text-link" href="/projects/">All projects →</a>
			</div>
			<div class="project-grid">
				{projects.map((project) => (
					<article class="project-card">
						<a
							class="project-image"
							href={project.href}
							aria-label={`View ${project.title} case study`}
						>
							<img
								src={project.image}
								alt={project.alt}
								loading="lazy"
								decoding="async"
							/>
						</a>
						<div class="project-copy">
							<span class="project-status">{project.status}</span>
							<h3><a href={project.href}>{project.title}</a></h3>
							<p>{project.text}</p>
							<a
								class="text-link"
								href={project.href}
								aria-label={`Read the ${project.title} case study`}
							>
								Read case study <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="process-title">
			<span class="eyebrow">Working together</span>
			<h2 id="process-title">Clear scope. Regular reviews. Planned delivery.</h2>
			<ol class="process-grid">
				<li>
					<h3>Plan the requirements</h3>
					<p>
						We define the audience, pages, features, resources, budget, and timeline.
					</p>
				</li>
				<li>
					<h3>Build & refine</h3>
					<p>
						I develop the website and share progress for feedback on the agreed work.
					</p>
				</li>
				<li>
					<h3>Check & launch</h3>
					<p>
						We review key flows, mobile layouts, links, and launch configuration
						before the agreed handover.
					</p>
				</li>
			</ol>
		</section>

		<section class="section" aria-labelledby="faq-title">
			<span class="eyebrow">Before we start</span>
			<h2 id="faq-title">Common web development questions.</h2>
			<div class="faq-list">
				{questions.map((question) => (
					<details>
						<summary>{question.title}</summary>
						<p>{question.text}</p>
					</details>
				))}
			</div>
		</section>

		<aside class="related-service" aria-labelledby="android-title">
			<div>
				<span class="eyebrow">Also building for mobile?</span>
				<h2 id="android-title">Explore native Android development.</h2>
				<p>
					Kotlin and Jetpack Compose applications with local storage,
					Firebase, or API integration.
				</p>
			</div>
			<a class="button secondary" href="/services/android-app-development/">
				Android development <span aria-hidden="true">→</span>
			</a>
		</aside>
	</main>
</Layout>

<style>
	.web-page {
		width: min(1120px, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 2rem 4rem;
	}
	h1, h2, h3, p { margin-top: 0; }
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: var(--color-muted);
		font-size: 0.75rem;
	}
	.breadcrumb a, .text-link { color: #75d6ff; text-decoration: none; }
	.breadcrumb a:hover, .text-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.hero { max-width: 950px; padding-block: 3rem 4.5rem; }
	.eyebrow {
		color: var(--color-accent);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.hero h1 {
		margin: 0.75rem 0 1.2rem;
		font-size: clamp(2.6rem, 5.5vw, 4.8rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}
	.hero h1 em {
		display: block;
		color: var(--color-accent);
		font-style: normal;
	}
	.hero > p {
		max-width: 700px;
		margin-bottom: 1.7rem;
		color: var(--color-muted);
		font-size: 1rem;
	}
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		min-height: 48px;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		font-size: 0.84rem;
		font-weight: 750;
		text-decoration: none;
	}
	.primary { background: var(--color-accent); color: #04111d; }
	.primary:hover { background: #75d6ff; }
	.secondary {
		border-color: #2c4058;
		background: #111a29;
		color: var(--color-text);
	}
	.secondary:hover { border-color: var(--color-accent); }
	.hero-points {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.2rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.78rem;
	}
	.hero-points li::before {
		content: '✓';
		margin-right: 0.4rem;
		color: #34d399;
	}
	h2 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		line-height: 1.2;
		letter-spacing: -0.035em;
	}
	h3 { font-size: 1.1rem; line-height: 1.4; }
	.section-intro {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.9rem;
	}
	.service-grid, .project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.card {
		padding: 1.6rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: var(--color-surface);
	}
	.card h3 { margin-bottom: 0.6rem; }
	.card p, .project-copy p, .process-grid p {
		color: var(--color-muted);
		font-size: 0.86rem;
	}
	.feature-list {
		display: grid;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.feature-list li { color: #d0dbea; font-size: 0.8rem; }
	.feature-list li::before {
		content: '✓';
		margin-right: 0.5rem;
		color: var(--color-accent);
	}
	.section { margin-top: 4rem; }
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}
	.section-heading h2 { margin-bottom: 0; }
	.text-link { font-size: 0.82rem; font-weight: 700; }
	.project-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: var(--color-surface);
	}
	.project-image {
		display: block;
		aspect-ratio: 1.8;
		overflow: hidden;
		background: #111a29;
	}
	.project-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.project-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.4rem;
	}
	.project-status { color: #75d6ff; font-size: 0.72rem; font-weight: 700; }
	.project-copy h3 { margin: 0.5rem 0; }
	.project-copy h3 a { color: var(--color-text); text-decoration: none; }
	.project-copy h3 a:hover { color: #75d6ff; }
	.project-copy .text-link { margin-top: auto; }
	.process-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 1.5rem 0 0;
		padding-left: 1.5rem;
	}
	.process-grid li { padding-left: 0.3rem; }
	.process-grid li::marker { color: var(--color-accent); font-weight: 750; }
	.process-grid h3 { margin-bottom: 0.5rem; }
	.process-grid p { margin-bottom: 0; }
	.faq-list { display: grid; gap: 0.75rem; margin-top: 1.5rem; }
	details {
		padding: 1rem 1.2rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface);
	}
	summary { font-size: 0.9rem; font-weight: 650; cursor: pointer; }
	details p { margin: 0.8rem 0 0; color: var(--color-muted); font-size: 0.85rem; }
	.related-service {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-top: 4rem;
		padding: 2rem;
		border: 1px solid #1e3a50;
		border-radius: 1rem;
		background: #0d1d2b;
	}
	.related-service h2 { font-size: 1.7rem; }
	.related-service p { max-width: 600px; margin-bottom: 0; color: var(--color-muted); font-size: 0.85rem; }
	.related-service .button { flex-shrink: 0; }

	@media (max-width: 760px) {
		.process-grid { grid-template-columns: 1fr; }
		.related-service { align-items: flex-start; flex-direction: column; }
	}
	@media (max-width: 560px) {
		.web-page { width: calc(100% - 2.5rem); }
		.hero { padding-block: 2.5rem 3rem; }
		.actions { flex-direction: column; }
		.service-grid, .project-grid { grid-template-columns: 1fr; }
		.section-heading { align-items: flex-start; flex-direction: column; }
		.section, .related-service { margin-top: 3rem; }
		.card, .related-service { padding: 1.3rem; }
	}
</style>