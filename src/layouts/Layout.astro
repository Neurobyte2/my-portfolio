---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Ali Ansar | Android & Full-Stack Web Developer',
	description = 'Ali Ansar builds polished Android apps and fast, responsive full-stack websites for growing businesses.',
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#080d17" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/projects/portfolio-preview.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="brand">
				<a class="brand-photo-link" href="/images/ali-ansar-profile.png" target="_blank" rel="noreferrer" aria-label="Open full-size photo of Ali Ansar">
					<img class="brand-photo" src="/images/ali-ansar-profile.png" alt="Ali Ansar" />
				</a>
				<a class="brand-name" href="/" aria-label="Ali Ansar home">Ali Ansar<small>ANDROID · FULL-STACK WEB</small></a>
			</div>
			<nav aria-label="Main navigation">
				<a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
				<a href="/services/" aria-current={pathname === '/services' ? 'page' : undefined}>Services</a>
				<a href="/projects/" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
				<a href="/about/" aria-current={pathname === '/about' ? 'page' : undefined}>About</a>
			</nav>
			<a href="/contact/" class="header-cta">Let’s talk <span aria-hidden="true">↗</span></a>
		</header>
		<slot />
		<footer class="site-footer">
			<a class="footer-brand" href="/">Ali Ansar <span>·</span> Software Developer</a>
			<p>Thoughtful digital products, from the first screen to the systems behind it.</p>
			<div class="footer-links">
				<a href="/services/">Services</a>
				<a href="/projects/">Projects</a>
				<a href="/contact/">Contact</a>
				<a href="https://github.com/Neurobyte2" target="_blank" rel="noreferrer">GitHub ↗</a>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { overflow-x: hidden; scroll-behavior: smooth; }
	:global(body) {
		margin: 0;
		min-width: 320px;
		background: #080d17;
		color: #eff5ff;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		line-height: 1.65;
	}
	:global(a:focus-visible) { outline: 2px solid #38bdf8; outline-offset: 4px; }
	.site-header {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.1rem 2rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.12);
	}
	.brand, .footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
	}
	.footer-brand {
		color: #f8fafc;
		font-size: 0.95rem;
		font-weight: 750;
		line-height: 1.1;
		text-decoration: none;
	}
	.brand-name {
		color: #f8fafc;
		font-size: 0.95rem;
		font-weight: 750;
		line-height: 1.1;
		text-decoration: none;
	}
	.brand-name small {
		display: block;
		margin-top: 0.3rem;
		color: #8493aa;
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.11em;
	}
	.brand-photo-link {
		display: block;
		flex: 0 0 2.3rem;
		width: 2.3rem;
		height: 2.3rem;
		min-width: 0;
		overflow: hidden;
		border: 1px solid rgba(56, 189, 248, 0.35);
		border-radius: 0.7rem;
		background: #101827;
		transition: border-color 160ms ease, transform 160ms ease;
	}
	.brand-photo-link:hover {
		transform: translateY(-1px);
		border-color: #38bdf8;
	}
	.brand-photo {
		display: block;
		width: 100%;
		height: 100%;
		min-width: 0;
		object-fit: cover;
		object-position: center 24%;
	}
	.site-header nav, .footer-links {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2rem);
	}
	.site-header nav a, .footer-links a {
		color: #a9b5c8;
		font-size: 0.84rem;
		font-weight: 550;
		text-decoration: none;
		transition: color 160ms ease;
	}
	.site-header nav a:hover, .site-header nav a[aria-current="page"], .footer-links a:hover { color: #38bdf8; }
	.header-cta {
		padding: 0.65rem 1rem;
		border: 1px solid rgba(56, 189, 248, 0.35);
		border-radius: 0.65rem;
		color: #dff6ff;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}
	.header-cta span { margin-left: 0.45rem; color: #38bdf8; }
	.site-footer {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.5rem 2rem;
		max-width: 1200px;
		margin: 2rem auto 0;
		padding: 2.25rem 2rem 2.75rem;
		border-top: 1px solid rgba(148, 163, 184, 0.12);
	}
	.footer-brand { width: fit-content; }
	.footer-brand span { color: #38bdf8; }
	.site-footer p { grid-column: 1; margin: 0; color: #8290a6; font-size: 0.8rem; }
	.footer-links { grid-column: 2; grid-row: 1 / span 2; gap: 1.3rem; }
	.footer-links a { font-size: 0.78rem; }
	@media (max-width: 700px) {
		.site-header { flex-wrap: wrap; gap: 1rem; padding: 1rem 1.25rem; }
		.site-header nav { order: 3; width: 100%; justify-content: space-between; gap: 0.6rem; }
		.site-header nav a { font-size: 0.76rem; }
		.header-cta { margin-left: auto; }
		.site-footer { grid-template-columns: 1fr; padding: 2rem 1.25rem; }
		.site-footer p, .footer-links { grid-column: 1; grid-row: auto; }
		.footer-links { flex-wrap: wrap; gap: 0.8rem 1.2rem; margin-top: 0.6rem; }
	}
</style>
